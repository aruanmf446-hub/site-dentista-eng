---
/** Faixa de chamada para agendamento (vinho, topo em arco largo como o quadro A). */
import Title from '@/components/ui/Title.astro';
import Icon from '@/components/ui/Icon.astro';
import WaLink from '@/components/ui/WaLink.astro';

interface Props {
  titulo?: string;
  texto?: string;
  mensagem?: string | undefined;
  href?: string;
}
const {
  titulo = 'Ready for a *healthier smile?*',
  texto = 'Our team will reply on WhatsApp to arrange a convenient appointment.',
  mensagem,
  href = '/contact/',
} = Astro.props;
---

<section class="cta on-primary" data-surface="dark" aria-label="Appointments">
  <div class="cta__inner">
    <Title class="cta__title" text={titulo} data-reveal="title" />
    <p class="cta__text">{texto}</p>
    <div class="cta__actions">
      <WaLink class="btn btn--light btn--lg" mensagem={mensagem}><Icon name="whatsapp" size={20} />Book via WhatsApp</WaLink>
      <a href={href} class="btn btn--ghost-light btn--lg">Other ways to contact us</a>
    </div>
  </div>
</section>

<style>
  .cta {
    margin-top: var(--section-gap);
    background: var(--c-primary);
    color: var(--c-on-primary-2);
    border-radius: 50% 50% 0 0 / clamp(60px, 9vw, 160px) clamp(60px, 9vw, 160px) 0 0;
  }
  .cta__inner {
    max-width: 920px;
    margin-inline: auto;
    padding: clamp(100px, 10vw, 150px) var(--gutter) clamp(80px, 8vw, 120px);
    text-align: center;
  }
  .cta__title {
    font-family: var(--f-serif);
    font-size: var(--fs-display);
    line-height: 1;
    color: var(--c-on-primary);
  }
  .cta__title :global(em) {
    color: inherit;
  }
  .cta__text {
    margin-top: 20px;
    color: var(--c-on-primary-muted);
    font-size: var(--fs-lead);
  }
  .cta__actions {
    margin-top: 34px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
</style>
