---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
---

<BaseLayout path="/404/" title="Page not found" description="The page you requested could not be found.">
  <div class="container nf">
    <PageHeader trilha={[{ nome: 'Home', href: '/' }, { nome: 'Page not found' }]} rotulo="Erro 404" titulo="This page *does not exist.*" texto="The page may have moved. Return home or explore our treatments.">
      <div class="nf__ctas">
        <a href="/" class="btn btn--primary btn--lg">Back to home</a>
        <a href="/treatments/" class="btn btn--outline btn--lg">Browse treatments</a>
      </div>
    </PageHeader>
  </div>
</BaseLayout>

<style>
  .nf {
    min-height: 70vh;
    padding-bottom: 96px;
  }
  .nf__ctas {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
