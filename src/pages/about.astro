---
/** Página institucional: a clínica, galeria, responsável técnico e unidades. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import Sobre from '@/components/sections/Sobre.astro';
import Galeria from '@/components/sections/Galeria.astro';
import Unidades from '@/components/sections/Unidades.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import site, { siteUrl, semDestaque } from '@/lib/site';
import { breadcrumbLd } from '@/lib/seo';
import { rotaSobreAtiva } from '@/lib/routes';

if (!rotaSobreAtiva()) return Astro.redirect('/');
const { c } = site;
const base = siteUrl();
---

<BaseLayout
  path="/about/"
  title="About us"
  description={semDestaque(c.sobre!.titulo) + ' ' + c.site.descricao}
  jsonLd={[breadcrumbLd([{ nome: 'Home', url: `${base}/` }, { nome: 'About us', url: `${base}/about/` }])]}
>
  <div class="container page">
    <PageHeader trilha={[{ nome: 'Home', href: '/' }, { nome: 'About us' }]} rotulo="About us" titulo={c.sobre!.titulo} />
    <div class="page__section page__sobre"><Sobre /></div>
    {site.ativo('galeria') && <div class="page__section"><Galeria /></div>}
    <section class="page__section rt" aria-labelledby="rt-t">
      <Eyebrow texto="Professional credentials" />
      <h2 id="rt-t" class="rt__title">{c.legal.responsavelTecnico.nome}</h2>
      <p class="rt__text">{c.legal.responsavelTecnico.cro} · {c.legal.razaoSocial} · Business ID {c.legal.cnpj}</p>
    </section>
    {site.ativo('unidades') && <div class="page__section"><Unidades /></div>}
  </div>
  <CtaBand />
</BaseLayout>

<style>
  .page {
    padding-right: var(--gutter-r);
  }
  .page__section {
    margin-top: var(--section-gap);
  }
  .page__sobre {
    margin-top: 64px;
  }
  .page__sobre :global(.sobre__copy > .eyebrow),
  .page__sobre :global(.sobre__title) {
    display: none;
  }
  .rt__title {
    margin-top: 18px;
    font-family: var(--f-serif);
    font-size: var(--fs-h2-sm);
  }
  .rt__text {
    margin-top: 8px;
    color: var(--c-text);
  }
  @media (max-width: 899px) {
    .page {
      padding-right: var(--gutter);
    }
  }
</style>
